# Copy this file to vladis-backup.env on the NAS (same folder as
# vladis-backup.sh), fill in the real values, then:
#   chmod 600 vladis-backup.env
# Never commit the filled-in version to git — it holds real credentials.

# Settings → Database → Connection string → URI (the "Session pooler" one
# is fine for a once-a-week job). Keep the password URL-encoded as shown.
SUPABASE_DB_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Settings → Storage → S3 Connection (create an access key pair there if
# none exists yet). ENDPOINT looks like https://xxxxx.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT="https://xxxxx.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="eu-west-1"
SUPABASE_S3_ACCESS_KEY_ID="..."
SUPABASE_S3_SECRET_ACCESS_KEY="..."
SUPABASE_S3_BUCKET="dossier-salarie"

# Where backups land on the NAS (a shared folder, not the same volume as
# anything else critical) and how many weekly snapshots to keep.
BACKUP_ROOT="/volume1/Backups/vladis"
RETENTION_WEEKS=8
